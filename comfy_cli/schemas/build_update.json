{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://comfy.org/schemas/build_update.json",
  "title": "comfy build update --json data payload",
  "description": "The rescan diff, and the definition it would write or wrote.",
  "type": "object",
  "required": ["spec_file", "models_dir", "dry_run", "written", "summary", "diff", "definition"],
  "additionalProperties": true,
  "$defs": {
    "collection": {
      "type": "object",
      "required": ["added", "removed", "changed", "entries"],
      "additionalProperties": false,
      "properties": {
        "added": {"type": "integer"},
        "removed": {"type": "integer"},
        "changed": {"type": "integer"},
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["change", "name", "fields"],
            "additionalProperties": false,
            "properties": {
              "change": {"enum": ["added", "removed", "changed"]},
              "name": {"type": "string"},
              "fields": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "status": {"enum": ["changed", "unchanged"]}
  },
  "properties": {
    "spec_file": {"type": "string"},
    "models_dir": {"type": "string"},
    "custom_nodes_dir": {"type": ["string", "null"]},
    "dry_run": {"type": "boolean"},
    "written": {"type": "boolean"},
    "summary": {"type": "string"},
    "diff": {
      "type": "object",
      "description": "Per-category counts plus the affected entries, so an agent never parses the table. Collections carry counts and entries; every other definition key carries a bare changed/unchanged status.",
      "required": ["models", "customNodes"],
      "additionalProperties": {"$ref": "#/$defs/status"},
      "properties": {
        "models": {"$ref": "#/$defs/collection"},
        "customNodes": {"$ref": "#/$defs/collection"}
      }
    },
    "skipped_symlinks": {
      "description": "Symlinks excluded from a packaged custom node; present only when packaging skipped at least one. `location` points into this payload's definition, `localPath` names the node under custom_nodes/, and `member` is the symlink's path inside that node.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["location", "localPath", "member"],
        "additionalProperties": false,
        "properties": {
          "location": {"type": "string", "minLength": 1},
          "localPath": {"type": "string", "minLength": 1},
          "member": {"type": "string", "minLength": 1}
        }
      }
    },
    "definition": {"type": "object"}
  }
}
