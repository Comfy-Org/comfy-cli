{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://comfy.org/schemas/build_create.json",
  "title": "comfy build create --json data payload",
  "description": "Two shapes: preview (executed=false) carries `plan`; the live run (executed=true) carries the created ids.",
  "type": "object",
  "required": ["name", "executed"],
  "additionalProperties": true,
  "properties": {
    "name": {"type": "string"},
    "executed": {"type": "boolean"},
    "plan": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "definition": {
          "type": "object",
          "required": ["models", "customNodes"],
          "additionalProperties": true,
          "properties": {
            "models": {"type": "array"},
            "customNodes": {"type": "array"}
          }
        },
        "uploads": {"type": "array"},
        "upload_count": {"type": "integer"},
        "upload_bytes": {"type": "integer"}
      }
    },
    "buildId": {"type": "string", "description": "The created build's id."},
    "distributionId": {"type": "string", "description": "Deprecated alias of `buildId`, always identical to it. Emitted for one release so pinned scripts keep parsing; prefer `buildId`."},
    "releaseId": {"type": "string", "description": "The release cut from the new build."},
    "versionId": {"type": "string", "description": "Deprecated alias of `releaseId`, always identical to it. Emitted for one release so pinned scripts keep parsing; prefer `releaseId`."},
    "statusUrl": {"type": "string"},
    "uploaded": {"type": "integer"}
  },
  "oneOf": [
    {"properties": {"executed": {"const": false}}, "required": ["plan"]},
    {"properties": {"executed": {"const": true}}, "required": ["buildId", "distributionId", "releaseId", "versionId", "statusUrl"]}
  ]
}
