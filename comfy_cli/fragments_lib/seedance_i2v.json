{
  "_fragment": {
    "name": "seedance_i2v",
    "version": "1",
    "description": "ByteDance Seedance image-to-video: a still IMAGE + prompt -> VIDEO clip.",
    "terminal": false,
    "inputs": {
      "image": {"type": "IMAGE", "binds": "1.image"}
    },
    "outputs": {
      "video": {"type": "VIDEO", "from": "1", "port": 0}
    },
    "params": {
      "prompt": {"type": "STRING", "binds": "1.prompt", "default": ""},
      "model": {"type": "STRING", "binds": "1.model", "default": "seedance-1-0-pro-fast-251015"},
      "resolution": {"type": "STRING", "binds": "1.resolution", "default": "720p"},
      "aspect_ratio": {"type": "STRING", "binds": "1.aspect_ratio", "default": "16:9"},
      "duration": {"type": "INT", "binds": "1.duration", "default": 5},
      "seed": {"type": "INT", "binds": "1.seed", "default": 0}
    }
  },
  "1": {
    "class_type": "ByteDanceImageToVideoNode",
    "_meta": {"title": "ByteDance Seedance Image to Video"},
    "inputs": {
      "model": "seedance-1-0-pro-fast-251015",
      "prompt": "",
      "image": "PLACEHOLDER",
      "resolution": "720p",
      "aspect_ratio": "16:9",
      "duration": 5,
      "seed": 0
    }
  }
}
