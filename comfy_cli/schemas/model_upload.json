{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://comfy.org/schemas/model_upload.json",
  "title": "comfy model upload --json data payload",
  "description": "Content-bound model-library import plan or verified upload. No job is submitted. Null estimates/costs are unknown, never zero. --dry-run never uploads; mutation requires --yes and the approved SHA256/workspace.",
  "type": "object",
  "required": ["file", "name", "model_type", "size_bytes", "sha256", "hash", "workspace_id", "destination", "environment", "uploaded", "dry_run", "execution_state"],
  "properties": {
    "file": {"type": "string"},
    "name": {"type": "string"},
    "model_type": {"type": "string"},
    "size_bytes": {"type": "integer", "minimum": 0},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hash": {"type": "string", "pattern": "^blake3:[0-9a-f]{64}$"},
    "workspace_id": {"type": "string"},
    "workspace_name": {"type": ["string", "null"]},
    "destination": {"type": "string", "format": "uri"},
    "environment": {"const": "standard"},
    "uploaded": {"type": "boolean"},
    "deduped": {"type": "boolean"},
    "dry_run": {"type": "boolean"},
    "license": {"type": "string"},
    "nsfw": {"type": "string"},
    "estimated_upload_seconds": {"type": ["number", "null"]},
    "upload_cost": {"type": ["number", "null"]},
    "storage_cost": {"type": ["number", "null"]},
    "compute_cost": {"type": ["number", "null"]},
    "execution_state": {"const": "prepared, not run"},
    "asset_id": {"type": "string"},
    "loader_path": {"type": "string"},
    "created_new": {"type": ["boolean", "null"]}
  },
  "additionalProperties": false
}
