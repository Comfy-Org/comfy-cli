{
  "_fragment": {
    "name": "sdxl_t2i_lora",
    "version": "1",
    "description": "SDXL text-to-image with a LoRA: checkpoint + lora -> IMAGE. Model filenames are required params — discover them with `comfy models search --type checkpoint` / `--type lora`.",
    "terminal": false,
    "inputs": {},
    "outputs": {
      "image": {"type": "IMAGE", "from": "7", "port": 0}
    },
    "params": {
      "ckpt_name": {
        "type": "STRING",
        "binds": "1.ckpt_name",
        "description": "SDXL checkpoint filename — discover via `comfy models search --type checkpoint`"
      },
      "lora_name": {
        "type": "STRING",
        "binds": "2.lora_name",
        "description": "LoRA filename — discover via `comfy models search --type lora`"
      },
      "lora_strength_model": {
        "type": "FLOAT",
        "binds": "2.strength_model",
        "default": 0.8
      },
      "lora_strength_clip": {
        "type": "FLOAT",
        "binds": "2.strength_clip",
        "default": 0.8
      },
      "prompt": {
        "type": "STRING",
        "binds": "3.text"
      },
      "negative": {
        "type": "STRING",
        "binds": "4.text",
        "default": ""
      },
      "seed": {
        "type": "INT",
        "binds": "6.seed",
        "default": 0
      },
      "steps": {
        "type": "INT",
        "binds": "6.steps",
        "default": 25
      },
      "cfg": {
        "type": "FLOAT",
        "binds": "6.cfg",
        "default": 7.0
      },
      "width": {
        "type": "INT",
        "binds": "5.width",
        "default": 1024
      },
      "height": {
        "type": "INT",
        "binds": "5.height",
        "default": 1024
      }
    }
  },
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "_meta": {"title": "Load Checkpoint"},
    "inputs": {
      "ckpt_name": "PLACEHOLDER"
    }
  },
  "2": {
    "class_type": "LoraLoader",
    "_meta": {"title": "Load LoRA"},
    "inputs": {
      "model": ["1", 0],
      "clip": ["1", 1],
      "lora_name": "PLACEHOLDER",
      "strength_model": 0.8,
      "strength_clip": 0.8
    }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "Positive Prompt"},
    "inputs": {
      "text": "PLACEHOLDER",
      "clip": ["2", 1]
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "Negative Prompt"},
    "inputs": {
      "text": "",
      "clip": ["2", 1]
    }
  },
  "5": {
    "class_type": "EmptyLatentImage",
    "_meta": {"title": "Empty Latent Image"},
    "inputs": {
      "width": 1024,
      "height": 1024,
      "batch_size": 1
    }
  },
  "6": {
    "class_type": "KSampler",
    "_meta": {"title": "KSampler"},
    "inputs": {
      "model": ["2", 0],
      "positive": ["3", 0],
      "negative": ["4", 0],
      "latent_image": ["5", 0],
      "seed": 0,
      "steps": 25,
      "cfg": 7.0,
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 1.0
    }
  },
  "7": {
    "class_type": "VAEDecode",
    "_meta": {"title": "VAE Decode"},
    "inputs": {
      "samples": ["6", 0],
      "vae": ["1", 2]
    }
  }
}
