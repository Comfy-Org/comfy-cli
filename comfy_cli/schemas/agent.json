{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "comfy agent permissions",
  "description": "Output shape for `comfy agent permissions`: the local comfy agent's requests waiting for the user, the folders and hosts the user approved, and a running agent's sandbox. Read-only: the user approves or denies a request in the agent panel.",
  "type": "object",
  "properties": {
    "data_dir": {
      "type": "string"
    },
    "agent": {
      "type": "object",
      "properties": {
        "running": {
          "type": "boolean"
        },
        "port": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "running",
        "port"
      ]
    },
    "sandbox": {
      "type": [
        "object",
        "null"
      ]
    },
    "comfy_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "pending": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "A request the agent's request_path / request_host tool recorded; only a human approves it.",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{16}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "path",
              "host"
            ]
          },
          "target": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "requested_at": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "target"
        ]
      }
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "approved_at": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ]
      }
    },
    "hosts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "host": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "approved_at": {
            "type": "string"
          }
        },
        "required": [
          "host"
        ]
      }
    },
    "note": {
      "type": "string",
      "description": "Where the user approves or denies a pending request: the agent panel. No CLI command approves or grants."
    }
  },
  "required": [
    "data_dir",
    "agent",
    "sandbox",
    "comfy_path",
    "pending",
    "paths",
    "hosts",
    "note"
  ]
}
