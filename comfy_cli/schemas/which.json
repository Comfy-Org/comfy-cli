{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://comfy.org/schemas/which.json",
  "title": "comfy which --json data payload",
  "type": "object",
  "required": ["workspace_path"],
  "additionalProperties": true,
  "properties": {
    "exists": {"type": "boolean", "description": "Whether the workspace directory exists on disk."},
    "desktop": {
      "type": "object",
      "description": "Desktop installation records, including separate code, data, Python, and model roots.",
      "properties": {
        "code_dir": {"type": ["string", "null"]},
        "data_dir": {"type": ["string", "null"]},
        "custom_nodes_dir": {"type": ["string", "null"]},
        "python": {"type": ["string", "null"]},
        "input_dir": {"type": "string", "description": "Effective input directory of the selected running Desktop server."},
        "output_dir": {"type": "string", "description": "Effective output directory of the selected running Desktop server."},
        "output_dir_source": {"enum": ["server_argv", "server_default"]},
        "selected_reason": {"type": ["string", "null"]},
        "comfyui_version": {"type": ["string", "null"]},
        "model_roots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "source", "exists"],
            "properties": {
              "path": {"type": "string"},
              "source": {"enum": ["data", "shared", "install"]},
              "exists": {"type": "boolean"}
            }
          }
        },
        "installs": {"type": "array", "items": {"type": "object"}},
        "problems": {"type": "array", "items": {"type": "string"}}
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {"code": {"type": "string"}, "message": {"type": "string"}}
      }
    },
    "workspace_path": {"type": ["string", "null"]},
    "workspace_type": {"type": ["string", "null"]}
  }
}
