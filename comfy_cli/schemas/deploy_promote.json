{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://comfy.org/schemas/deploy_promote.json",
  "title": "comfy deploy promote --json data payload",
  "type": "object",
  "required": [
    "deployment",
    "source",
    "release",
    "previousRelease",
    "waiting"
  ],
  "additionalProperties": false,
  "properties": {
    "deployment": {
      "type": "object",
      "required": [
        "id",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "queued",
            "provisioning",
            "starting",
            "ready",
            "unhealthy",
            "stopping",
            "stop_failed",
            "stopped",
            "failed"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "release": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "description": "The release the deployment serves, or moves to while an update waits. `version` is absent when the release could not be read after the promote was accepted."
    },
    "previousRelease": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "description": "The release the deployment served before the promote."
    },
    "waiting": {
      "type": "boolean",
      "description": "True while the promote waits for its release's copy to be ready; the release in `release` serves only once it lands."
    }
  }
}
