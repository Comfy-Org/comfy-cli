{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://comfy.org/schemas/deploy_ls.json",
  "title": "comfy deploy ls --json data payload",
  "type": "object",
  "required": ["deployments", "scope"],
  "additionalProperties": false,
  "if": {"properties": {"scope": {"const": "build"}}},
  "then": {"required": ["buildId"]},
  "else": {"not": {"required": ["buildId"]}},
  "properties": {
    "scope": {
      "enum": ["build", "workspace"],
      "description": "What was listed: `build` for one Build's deployments (the spec at PATH or in the current folder), `workspace` for every Build's (`--workspace`, or a bare `deploy ls` with no spec in the current folder)."
    },
    "buildId": {
      "type": "string",
      "minLength": 1,
      "description": "The Build whose deployments were listed. Present only when `scope` is `build`."
    },
    "deployments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "createdAt",
          "id",
          "name",
          "releaseId",
          "status",
          "updatedAt"
        ],
        "additionalProperties": true,
        "properties": {
          "computeConfig": {"type": ["object", "null"]},
          "createdAt": {"type": "string", "format": "date-time"},
          "deletedAt": {"type": ["string", "null"], "format": "date-time"},
          "deletedBy": {"type": ["string", "null"]},
          "editor": {
            "type": ["boolean", "null"],
            "description": "Whether the deployment keeps a CPU server for the editor; null where comfy-deploy did not say."
          },
          "endpointUrl": {"type": ["string", "null"]},
          "id": {"type": "string", "minLength": 1},
          "name": {
            "type": ["string", "null"],
            "minLength": 1,
            "description": "The deployment's name, unique among its Build's live deployments; null where it has none or comfy-deploy does not serve names yet."
          },
          "releaseId": {"type": "string", "minLength": 1},
          "releaseVersion": {
            "type": "integer",
            "minimum": 1,
            "description": "The version of the release the deployment serves. Present when the list is one Build's; absent under --workspace, where rows span Builds."
          },
          "status": {
            "enum": ["queued", "provisioning", "starting", "ready", "unhealthy", "stopping", "stop_failed", "stopped", "failed"]
          },
          "updatedAt": {"type": "string", "format": "date-time"}
        }
      }
    }
  }
}
