{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://comfy.org/schemas/workflow_check.json",
  "title": "comfy workflow check --json data payload",
  "description": "Whether Comfy Cloud runs a workflow as it is. verdict: covered (every node type and model is on Cloud, each model proven the same file), covered_with_remaps (runs once each remap in models[] is applied), covered_needs_check (nothing missing, but a model is not proven the same file as Cloud's copy), needs_build (blocking[] lists what is missing).",
  "type": "object",
  "required": [
    "workflow",
    "format",
    "verdict",
    "blocking",
    "models",
    "nodes",
    "skipped",
    "out",
    "remaps_applied",
    "warnings"
  ],
  "additionalProperties": true,
  "$defs": {
    "filename": {"type": "string", "description": "The model's file name, without folders."},
    "folder": {
      "type": ["string", "null"],
      "description": "The ComfyUI models folder the file belongs in (e.g. checkpoints, loras), from the workflow's download notes or the stock loader; null when unknown."
    },
    "url": {"type": ["string", "null"], "description": "Download URL from the workflow's own download notes, if any."},
    "local_paths": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Files of this name under --models-dir; empty without --models-dir."
    }
  },
  "properties": {
    "workflow": {"type": "string", "description": "Absolute path of the checked file; never changed."},
    "format": {"enum": ["ui", "api"]},
    "verdict": {"enum": ["covered", "covered_with_remaps", "covered_needs_check", "needs_build"]},
    "blocking": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["kind", "class_type", "node_ids", "reason"],
            "properties": {
              "kind": {"const": "node"},
              "class_type": {"type": "string"},
              "node_ids": {"type": "array", "items": {"type": "string"}},
              "reason": {"const": "not_on_cloud"}
            }
          },
          {
            "type": "object",
            "required": ["kind", "value", "node_id", "class_type", "reason", "filename", "folder", "url", "local_paths"],
            "properties": {
              "kind": {"const": "model"},
              "value": {"type": "string"},
              "node_id": {"type": "string"},
              "class_type": {"type": "string"},
              "reason": {"enum": ["not_on_cloud", "ambiguous", "different_file"]},
              "filename": {"$ref": "#/$defs/filename"},
              "folder": {"$ref": "#/$defs/folder"},
              "url": {"$ref": "#/$defs/url"},
              "local_paths": {"$ref": "#/$defs/local_paths"}
            }
          }
        ]
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "node_id",
          "class_type",
          "widget",
          "value",
          "status",
          "source",
          "cloud_value",
          "identity",
          "filename",
          "folder",
          "url",
          "local_paths"
        ],
        "properties": {
          "node_id": {"type": "string", "description": "Node id; inside a subgraph, <instance id>/<inner id>."},
          "class_type": {"type": "string"},
          "widget": {"type": ["string", "null"], "description": "Input name, when known."},
          "value": {"type": "string", "description": "The value saved in the workflow."},
          "status": {"enum": ["present", "remap", "missing", "not_checked"]},
          "source": {"enum": ["cloud", "yours", null]},
          "cloud_value": {"type": ["string", "null"], "description": "The value Cloud runs; differs from value on a remap."},
          "identity": {"enum": ["same", "different", "unverified", null]},
          "candidates": {"type": "array", "items": {"type": "string"}},
          "filename": {"$ref": "#/$defs/filename"},
          "folder": {"$ref": "#/$defs/folder"},
          "url": {"$ref": "#/$defs/url"},
          "local_paths": {"$ref": "#/$defs/local_paths"}
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["class_type", "node_ids", "on_cloud"],
        "properties": {
          "class_type": {"type": "string"},
          "node_ids": {"type": "array", "items": {"type": "string"}},
          "on_cloud": {"type": "boolean"}
        }
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node_id", "class_type", "why"],
        "properties": {
          "node_id": {"type": "string"},
          "class_type": {"type": ["string", "null"]},
          "why": {"enum": ["muted", "bypassed"]}
        }
      }
    },
    "out": {"type": ["string", "null"], "description": "Where --apply-remaps wrote the copy; null without it."},
    "remaps_applied": {"type": "integer", "minimum": 0},
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {"code": {"type": "string"}, "message": {"type": "string"}}
      }
    }
  }
}
