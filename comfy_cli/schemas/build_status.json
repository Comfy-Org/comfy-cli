{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://comfy.org/schemas/build_status.json",
  "title": "comfy build status --json data payload",
  "type": "object",
  "required": [
    "build",
    "spec",
    "remote",
    "local",
    "hint"
  ],
  "additionalProperties": false,
  "if": {
    "properties": {
      "remote": {
        "properties": {
          "state": {
            "const": "not_pushed"
          }
        }
      }
    }
  },
  "else": {
    "properties": {
      "build": {
        "required": [
          "id"
        ]
      }
    }
  },
  "$defs": {
    "counts": {
      "type": "object",
      "required": [
        "added",
        "removed",
        "changed"
      ],
      "additionalProperties": false,
      "properties": {
        "added": {
          "type": "integer",
          "minimum": 0
        },
        "removed": {
          "type": "integer",
          "minimum": 0
        },
        "changed": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "properties": {
    "build": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "The Build compared against: `--id`, else the spec's id. Present whenever `remote.state` is `pushed`; absent when neither names one, so the spec was never pushed (`remote.state` is `not_pushed`)."
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "spec": {
      "type": "object",
      "required": [
        "path",
        "syncedRevision"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "syncedRevision": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "remote": {
      "type": "object",
      "required": [
        "state",
        "revision",
        "behind"
      ],
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "pushed",
            "not_pushed"
          ],
          "description": "`not_pushed` when no Build id was found: nothing was read from the builder, `revision` is null, `behind` is false and `hint` names `comfy build push`. The local half is still reported."
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "behind": {
          "type": "boolean"
        }
      }
    },
    "local": {
      "type": "object",
      "required": [
        "scanned",
        "drift"
      ],
      "additionalProperties": false,
      "properties": {
        "scanned": {
          "type": "boolean",
          "description": "Whether the install was scanned. False when --no-scan was passed or no install is present."
        },
        "reason": {
          "type": "string",
          "description": "Why the install was not scanned. Present only when `scanned` is false."
        },
        "drift": {
          "description": "Definition drift between the spec and the install, or null when `scanned` is false.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "models",
                "customNodes"
              ],
              "properties": {
                "models": {
                  "$ref": "#/$defs/counts"
                },
                "customNodes": {
                  "$ref": "#/$defs/counts"
                }
              },
              "additionalProperties": {
                "enum": [
                  "changed",
                  "unchanged"
                ]
              }
            }
          ]
        }
      },
      "description": "The spec-vs-install comparison. `scanned` is the flag to branch on: false means this half was NOT computed -- `reason` says why and `drift` is null -- not that the spec and the install agree. A spec written by hand has no install to scan, and that must not fail the spec-vs-remote half."
    },
    "hint": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
